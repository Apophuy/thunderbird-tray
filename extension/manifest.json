{
  "manifest_version": 3,
  "name": "thunderbird-tray",
  "description": "Reports Thunderbird state to the thunderbird-tray Linux companion.",
  "version": "0.1.5",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "156.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["accountsRead", "nativeMessaging"]
}
